# RIKU / QUANT — full env template.
# Copy the real values into Railway → service → Variables (or a local .env).
# Anything marked (secret) must NEVER be committed.

# ---------- Server ----------
# Local default 8490. On Railway leave QUANT_PORT unset — the injected PORT is used.
QUANT_PORT=
# /admin password — CHANGE THIS before hosting publicly!
ADMIN_PASSWORD=

# ---------- Wallet (secret!) ----------
# RIKU's hot wallet secret key: base58 string or JSON byte array. (secret)
QUANT_WALLET_SECRET=
# Alternative: path to a wallet.json (unused when QUANT_WALLET_SECRET is set)
QUANT_WALLET_FILE=

# ---------- Own token (launch day) ----------
QUANT_OWN_MINT=
# on-screen ticker for his own token (desk actions: BUYBACK/AIRDROP/BURN)
QUANT_OWN_SYMBOL=RIKU

# ---------- Solana RPC ----------
HELIUS_API_KEY=
# optional full override; defaults to Helius mainnet with the key above
RPC_URL=

# NOTE: pressing GO LIVE in /admin stores the token mint and FORCES the
# CALLOUT/TRADE/AIRDROP dry-runs OFF — the values below only matter pre-live.
# Emergency brake while live: FORCE_DRY_RUN=true re-enables all dry-runs.
FORCE_DRY_RUN=

# ---------- pump.fun callouts (Coin Communities) ----------
# From pump.fun DevTools Console while logged in as Riku's account:
#   localStorage.getItem("coin-community-auth")  → .state.refreshToken  (secret)
QUANT_CC_REFRESH_TOKEN=
CALLOUT_DRY_RUN=true
MAX_CALLOUTS_PER_DAY=10
# call gates (% of token supply sent to Riku)
MIN_SENT_PCT=0.05
AUTO_CALL_PCT=20

# ---------- Brain (LLM) ----------
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MODEL_FRAGMENT=claude-haiku-4-5
LLM_REASONING_EFFORT=low
LLM_DAILY_USD=10
LLM_PRICE_IN=5
LLM_PRICE_OUT=25

# ---------- Voice (TTS) ----------
# TTS is a CHAIN, not a single pick: TTS_PROVIDER only names who goes FIRST, and
# every other usable provider queues behind it (piper -> openai -> gtts -> silent).
# One drained balance can no longer mute the show.
#   piper  = FREE, neural, runs inside the container. No key, no rate limit. Default.
#   openai = best quality, ~$4/day at Riku's volume, prepaid balance keeps hitting 0
#   gtts   = free but Google blocks datacenter IPs, so it usually dies on Railway
#   edge   = DEAD: msedge-tts cannot connect at all any more (verified 2026-08-27)
#   none   = subtitles only
TTS_PROVIDER=piper
# NOTE: TTS_VOICE is an OPENAI voice name. Piper has its own (PIPER_VOICE below) —
# passing "onyx" to a non-openai provider is what made TTS_PROVIDER=edge fail on
# every single line.
TTS_VOICE=onyx
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_OPENAI_SPEED=1.05
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
# edge-only tuning
TTS_RATE=+8%
TTS_PITCH=-2Hz
# --- piper (free, baked into the image by the Dockerfile) ---
# Voices are installed by the PIPER_VOICES build arg; add one there before
# naming it here. A guest voice that reads as feminine maps to PIPER_VOICE_ALT,
# and an exact installed model name (e.g. en_US-amy-medium) always wins.
PIPER_BIN=/opt/piper/piper
PIPER_VOICE_DIR=/opt/piper/voices
PIPER_VOICE=en_US-ryan-medium
PIPER_VOICE_ALT=en_US-amy-medium
PIPER_LENGTH_SCALE=0.95
PIPER_SENTENCE_SILENCE=0.25
PIPER_TIMEOUT_MS=20000

# ---------- Show pacing ----------
MIN_SENT_USD=1.2
SENDER_COOLDOWN_MIN=10
CONVEYOR_PICK_MIN=5
COMMENTARY_MIN=9
INBOX_POLL_S=15
STATS_REFRESH_S=

# ---------- Buyback ----------
FLOAT_SOL=0.05
MIN_BUYBACK_SOL=0.02
MAX_BUYBACK_SOL_PER_TX=0.5
MAX_BUYBACK_SOL_PER_DAY=2
BUYBACK_POLL_S=300

# X read quota is metered in POSTS RETRIEVED, not requests. The mention sweep
# asked for 25 every 20 min = 1,800 posts/day on an account that never sees that
# many. The v2 floor is 5.
X_MENTIONS_MAX=6
# send every read twexapi can serve (KOL timelines, outreach search) to twexapi
# instead of the official API — billed on the twexapi key, not the X quota.
# false puts everything back on the official API.
X_PREFER_TWEX_READS=true

# --- twexapi: off-quota READS (search + timelines) AND the replies the
#     official API tier refuses (KOL replies). Reads need only TWEXAPI_KEY;
#     replies also need the auth_token/cookie. ---
# key: https://twexapi.io/dashboard | auth_token: RIKU X account cookie
TWEXAPI_KEY=
TWEX_AUTH_TOKEN=
# or paste the whole cookie instead of the auth_token:
# TWEX_COOKIE=

# ---------- Agent ----------
AGENT_ENABLED=true
AGENT_PLAN_MIN=12
# false = wallet only moves on dev snipes + operator calls (research stays content)
AUTONOMOUS_BUYS=false
TRADE_DRY_RUN=true
MAX_TRADE_SOL=2
MAX_DAILY_TRADE_SOL=10
MAX_OPEN_POSITIONS=9999
TRADE_RESERVE_SOL=0.3
# a sold coin can't be re-bought for this many hours (blacklisted = forever)
REBUY_COOLDOWN_H=72
# --- decision ledger: sha256 of every buy/sell/call memo'd to Solana BEFORE
# execution, revealed at /public/decisions (proof the track record isn't backdated)
COMMIT_ONCHAIN=true
COMMIT_KINDS=buy,sell,call
# --- caller intel: background harvest of pump.fun callout pages (public
# route, not the CC API) → reputation index of other callers
CALLER_HARVEST_S=90
CALLER_REFRESH_H=6
# --- callout discovery: sweep trending coins' callout pages; a fresh call by
# a proven caller nominates the coin into the research queue (never a buy)
CALLER_DISCOVERY=true
CALLER_DISCOVERY_S=120
CALLER_DISCOVERY_AVG=1.5
CALLER_DISCOVERY_MIN_CALLS=3
CALLER_DISCOVERY_MAX_PER_DAY=8
# --- caller-follow: BUY on a graded caller's fresh call (median-room entry
# gate), EXIT when their wallet sells (on-chain 30s watch) + rug-guard stop
CALLER_FOLLOW=true
# sizing: CALLER_FOLLOW_PCT % of spendable SOL, scaled 0.75x/1x/1.5x by the
# caller's median+hit-rate quality; CALLER_FOLLOW_SOL is the FLOOR per buy
CALLER_FOLLOW_SOL=0.05
CALLER_FOLLOW_PCT=8
CALLER_FOLLOW_ROOM=2
CALLER_FOLLOW_MAX_PER_DAY=6
# exits are a scale-out LADDER. TP1 = the caller's median target; TP2/moonbag are
# fixed multiples of OUR entry. Caller with a 2x median calling at 10k, we buy at
# 10k => TP1 sells 60% at 20k and arms a stop 20% under it (16k); TP2 sells 90% of
# what is left at 50k (36% of the original), leaving a 4% moonbag with NO target
# riding that same stop. STOP_PCT is the full-position stop-loss BEFORE TP1 only.
CALLER_FOLLOW_STOP_PCT=40
# TP1 fires at the CALLER'S MEDIAN TARGET (call mc x their clamped median), not
# a fixed multiple — it self-calibrates per caller. CALLER_FOLLOW_TP1_PCT is
# RETIRED: a flat +120% sat above where these coins actually peak.
CALLER_FOLLOW_TP1_MIN_PCT=25
CALLER_FOLLOW_TP1_FRACTION=0.6
CALLER_FOLLOW_TP2_PCT=400
CALLER_FOLLOW_TP2_FRACTION=0.9
CALLER_FOLLOW_RUNNER_STOP_PCT=20
# false: the stop stays where TP1 put it, so the moonbag can actually moon.
# true: TP2 drags the stop up to its own mc — locks the 5x, ends the ride.
CALLER_FOLLOW_STOP_REANCHOR=false
# anti-swarm: skip a mint that MORE than MAX_SWARM distinct callers stamped in
# the last SWARM_WINDOW_MIN minutes (a wave of calls IS the pump), and never
# enter above MAX_FROM_FIRST_CALL x the earliest known call's mc (caller
# medians are measured from THEIR call price — entering later buys a move
# that already happened)
CALLER_FOLLOW_MAX_SWARM=3
CALLER_FOLLOW_SWARM_WINDOW_MIN=10
CALLER_FOLLOW_MAX_FROM_FIRST_CALL=1.4
# a 5-call caller with an "8x median" is a pump farmer grading their own
# launches: the med used in room/target/sizing math is clamped to MED_CAP,
# and calls on coins under MIN_CALL_MC are ignored outright
CALLER_FOLLOW_MED_CAP=3
CALLER_FOLLOW_MIN_CALL_MC=10000

# ---- midcap: the INVESTMENT BOOK. Omo-inspired: established pump.fun-born
# mid-caps with a public identity (twitter + site/2nd social), real depth and
# a surviving tape get an LLM thesis; conviction >= MIN_CONVICTION buys
# MIDCAP_PCT% of spendable x (conviction/5), floor MIDCAP_SOL. DELIBERATELY
# NO AUTOMATIC EXITS (mid-caps recover from dips per operator judgment) —
# the ONLY exit is the operator selling from /admin/book.html.
MIDCAP=true
MIDCAP_TICK_MIN=30
MIDCAP_SOL=0.05
MIDCAP_PCT=5
MIDCAP_MAX_PER_DAY=2
MIDCAP_MIN_CONVICTION=4
MIDCAP_MIN_LIQ_USD=40000
MIDCAP_MIN_VOL24_USD=150000
MIDCAP_MIN_AGE_HOURS=6
MIDCAP_COOLDOWN_DAYS=3

# ---- outreach: find small crypto accounts on the timeline, draft RIKU
# replies, queue them for the producer at /admin/outreach.html. NOTHING sends
# without a producer click; the hourly rail is enforced server-side.
OUTREACH=true
OUTREACH_TICK_MIN=30
OUTREACH_MIN_FOLLOWERS=200
OUTREACH_MAX_FOLLOWERS=5000
OUTREACH_MAX_SENDS_PER_HOUR=2
OUTREACH_DEDUPE_DAYS=7
# the LIVE follow-feed (/following-positions/alerts): paste the Cookie header
# from a logged-in pump.fun browser session. Real-time callouts from every
# account that session FOLLOWS (follow the graded top callers to curate it),
# each with pump.fun's grading + the caller's live position. Empty = sweep only.
PUMP_COOKIE=
# conveyor research prefers coins with at least this much live mc
MIN_RESEARCH_MC_USD=4000
# --- dev-sniper: instant entries on proven-dev launches (never named on stream)
DEVSNIPE_ENABLED=false
# prime-only: fire ONLY on the elite dev list (dev_watchlist_prime.csv — the
# money bot's exact wallets). false = also watchlist/archive-qualified devs.
DEVSNIPE_PRIME_ONLY=true
DEVSNIPE_MAX_MC_USD=7000
DEVSNIPE_MIN_BOND_RATE=0.5
DEVSNIPE_MIN_LAUNCHES=3
DEVSNIPE_MAX_OPEN=10
DEVSNIPE_EXIT_PROGRESS=0.95
DEVSNIPE_MAX_HOLD_H=6
DEVSNIPE_REVEAL_DELAY_MS=150000
FILM_ENABLED=true
AIRDROP_DRY_RUN=true
MAX_AIRDROP_PCT_PER_DAY=5
IMAGES_PER_DAY=

# ---------- X / Twitter (Riku's own account) ----------
X_HANDLE=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
X_MAX_POSTS_PER_DAY=16
MAX_TWEETS_PER_DAY=
MIN_TWEETS_PER_DAY=
MIN_TWEET_GAP_MIN=
X_MAX_POST_LEN=
# optional read fallback (official bearer covers reads; usually not needed)
TWITTERAPI_IO_KEY=
# OAuth 2.0 client (unused by the posting flow; kept for future sign-in needs)
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=

# ---------- Coin Communities overrides (defaults baked in; rarely needed) ----------
CC_API_BASE=
CC_API_KEY=

# ---------- Sim / rehearsal (never live) ----------
SIM_MODE=false
SIM_SPEED=10
SIM_OWN_SUPPLY_PCT=
PAPER_START_SOL=5

# ---------- Local media tooling (not needed on Railway) ----------
BLENDER_PATH=
